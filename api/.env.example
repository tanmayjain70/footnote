# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development

# Runtime connection: the low-privilege application role. The API refuses to
# start if this role is a superuser or owns any table.
DATABASE_URL=postgresql+psycopg://footnote_app:app_dev_2026@localhost:5432/footnote

# Migrations only: the owning role. Never used to serve a request.
DATABASE_ADMIN_URL=postgresql+psycopg://footnote_owner:owner_dev_2026@localhost:5432/footnote

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- answering --------------------------------------------------------------
# "stub" answers extractively from the retrieved passages and costs nothing;
# it is what the tests use and what the demo falls back to without a key.
# "anthropic" sends the retrieved passages to a hosted model with citations
# enabled; set ANTHROPIC_API_KEY as well. Either way every citation is checked
# against the passages the model was shown before it is stored.
LLM_PROVIDER=stub
LLM_MODEL=claude-opus-5
# low | medium | high. Medium keeps a streamed answer snappy; raise it if
# answers start missing nuance in long clauses.
LLM_EFFORT=medium
LLM_MAX_TOKENS=2048
ANTHROPIC_API_KEY=
# Only for tests, which point the client at a fake server.
# ANTHROPIC_BASE_URL=

# --- embeddings -------------------------------------------------------------
# "fastembed" runs BAAI/bge-small-en-v1.5 locally (384 dimensions, ~65 MB,
# downloaded once into FASTEMBED_CACHE_DIR). "hashed" is a deterministic
# feature-hashing embedding of the same width, for tests and CI: no download,
# identical vectors on every run, and retrieval that is lexical rather than
# semantic. Do not switch providers on an existing database without
# re-ingesting: vectors from different models cannot be compared.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_CACHE_DIR=.fastembed_cache
FASTEMBED_THREADS=2

# --- retrieval --------------------------------------------------------------
# Passages shown to the model per question, candidates taken from each leg
# (vector and lexical) before fusion, and the reciprocal-rank-fusion constant.
RETRIEVAL_K=8
RETRIEVAL_CANDIDATES=30
RETRIEVAL_RRF_K=60
# Chunk size in characters. Chunks never split a sentence.
CHUNK_TARGET_CHARS=1100

# --- background work --------------------------------------------------------
# The worker thread claims ingest, extraction and evaluation jobs from the
# jobs table. Tests turn it off and drain the queue synchronously.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
MAX_UPLOAD_MB=25

# Seeds the demo data at start when true. Idempotent.
DEMO_MODE=false

CORS_ORIGINS=["http://localhost:5173"]
SQL_ECHO=false
